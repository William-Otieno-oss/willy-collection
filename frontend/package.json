{
  "name": "sneaker-store-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"try{require('fs').rmSync('.next/trace',{force:true})}catch(e){}\" && next dev",
    "build": "node -e \"try{require('fs').rmSync('.next/trace',{force:true})}catch(e){}\" && next build",
    "start": "next start",
    "prod": "npm run build && next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "next": "13.4.10",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-swipeable": "^7.0.2",
    "swr": "2.1.3"
  },
  "devDependencies": {
    "autoprefixer": "10.4.14",
    "node-vibrant": "^3.1.6",
    "postcss": "8.4.24",
    "tailwindcss": "3.4.7",
    "@opennextjs/cloudflare": "0.6.6",
    "wrangler": "4.110.0"
  }
}
