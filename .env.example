# ============================================================================
# Willy Collection Website - Complete Environment Configuration
# ============================================================================
# Copy this file to .env and update values for your environment
# CRITICAL: Change all secrets in production - do NOT use defaults
# ============================================================================

# ============================================================================
# APPLICATION ENVIRONMENT
# ============================================================================
NODE_ENV=production
LOG_LEVEL=warn

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# For production: Use PostgreSQL or MySQL instead of SQLite
# SQLite format: file:./path/to/database.db
# PostgreSQL: postgresql://user:password@host:port/dbname
# MySQL: mysql://user:password@host:port/dbname
DATABASE_URL=file:./data/prod.db

# ============================================================================
# BACKEND SERVER CONFIGURATION
# ============================================================================
PORT=4000
BACKEND_HOST=0.0.0.0

# CORS: Comma-separated list of allowed origins
# CRITICAL: Do not use * in production
# Example: https://yourdomain.com,https://www.yourdomain.com,https://admin.yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================================================
# SECURITY: JWT & AUTHENTICATION
# ============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: Must be strong and unique for production
JWT_SECRET=your-super-secret-jwt-key-change-in-production-generate-new

# JWT token expiration (in seconds, 8 hours = 28800)
JWT_EXPIRATION_SECONDS=28800

# ============================================================================
# RATE LIMITING
# ============================================================================
# Window in milliseconds (900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per IP per window
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# FILE UPLOAD CONFIGURATION
# ============================================================================
# Maximum file upload size in bytes (5MB = 5242880)
MAX_UPLOAD_SIZE=5242880
# Maximum number of files per upload request
MAX_FILES=16

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
# Backend API URL accessible from frontend
# For production: Must be HTTPS and match ALLOWED_ORIGINS
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# or
# NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# ============================================================================
# AWS S3 / S3-COMPATIBLE STORAGE CONFIGURATION
# ============================================================================
# Optional: Only enable if using S3 for image storage (recommended for production)
# Leave commented out to use local file storage

# AWS Region
# AWS_REGION=us-east-1

# AWS S3 Credentials
# CRITICAL: Use IAM roles in production, never hardcode credentials
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# S3 Bucket Name
# AWS_S3_BUCKET=willy-collection-prod

# S3 Endpoint (optional, for S3-compatible services like MinIO)
# AWS_S3_ENDPOINT=https://s3.amazonaws.com
# or for MinIO:
# AWS_S3_ENDPOINT=https://minio.yourdomain.com:9000

# ============================================================================
# VIRUS SCANNING CONFIGURATION
# ============================================================================
# Enable ClamAV virus scanning for uploaded files (recommended for production)
ENABLE_VIRUS_SCANNING=false
# Path to clamscan binary (automatic detection if not specified)
# CLAMSCAN_BIN=/usr/bin/clamscan

# ============================================================================
# ANALYTICS & MONITORING
# ============================================================================
# Optional: Google Analytics ID
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXXXX

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable newsletter signup
# NEXT_PUBLIC_ENABLE_NEWSLETTER=true

# ============================================================================
# OPTIONAL: EMAIL CONFIGURATION (Future use)
# ============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password
# SMTP_FROM=noreply@yourdomain.com

# ============================================================================
# DOCKER & DEPLOYMENT
# ============================================================================
# Docker compose environment (production/staging/development)
DOCKER_ENV=production
# Image registry (e.g., docker.io, gcr.io, your-registry.azurecr.io)
# DOCKER_REGISTRY=docker.io
# Docker image version tag
# DOCKER_TAG=latest

# ============================================================================
# MONITORING & ALERTING
# ============================================================================
# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-sentry-project@sentry.io/project-id

# ============================================================================
# SECURITY HEADERS
# ============================================================================
# CSP (Content Security Policy) - customize for your needs
# Default is restrictive. Adjust if needed for external resources
# CSP_HEADER=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:;

# ============================================================================
# NOTES FOR PRODUCTION DEPLOYMENT
# ============================================================================
# 1. SECRETS MANAGEMENT:
#    - Use a secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
#    - Never commit .env files to version control
#    - Use .env.gitignore to prevent accidental commits
#    - Rotate secrets regularly
#
# 2. HTTPS/TLS:
#    - Always use HTTPS in production
#    - Use certificates from Let's Encrypt or your provider
#    - Enforce HSTS (HTTP Strict Transport Security)
#
# 3. DATABASE:
#    - Use managed database service (RDS, Cloud SQL, etc.)
#    - Enable backups and point-in-time recovery
#    - Use strong passwords
#    - Restrict network access with security groups
#
# 4. CORS:
#    - Specify exact allowed origins
#    - Never use * for production
#    - Regularly audit CORS settings
#
# 5. RATE LIMITING:
#    - Consider using Redis for distributed rate limiting
#    - Adjust limits based on your user base
#
# 6. MONITORING:
#    - Set up centralized logging (ELK, Datadog, etc.)
#    - Monitor error rates and performance
#    - Set up alerts for critical issues
#
# 7. BACKUPS:
#    - Regularly backup database and uploaded files
#    - Test restore procedures
#    - Store backups securely
